# Jupyter Notebook
.ipynb_checkpoints

# CatBoost writes training logs here on every fit()
catboost_info/

# Environment variables
.env
.env.local

# Data — scraped/intermediate files are not published, only reproduced.
data/raw/**/*.csv
data/raw/**/*.jsonl
data/raw/**/*.json
data/processed/*.csv
data/interim/**/*.csv
# data/history/ — listing history written by `scrape --track-history`
data/history/**/*.jsonl
# External data: raw OSM extracts (~1.5 GB) are not stored — re-downloaded by
# scripts/prepare_osm_poi.py. The small POI table the geo features need is.
data/external/*
!data/external/osm_poi.csv
!data/external/osm_poi_manifest.json
*.parquet
*.feather

# Models: experiment artifacts are not tracked (large, reproducible by
# rerunning training). Tracked: the current model (XGBoost + geo) and the
# earlier model without geo features, used by the comparison scripts and
# the inference-parity tests.
models/*.pkl
!models/xgboost_20260909_112549.pkl
!models/xgboost_20260827_131014.pkl
models/*.h5
models/*.joblib

# Logs
logs/
*.log

# Local analysis/training output — regenerated by scripts/*.py. Final
# results live in README.md / MODEL_CARD.md / DATA_CARD.md instead.
reports/

# Pytest / linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

