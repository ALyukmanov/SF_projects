catboost_info/

# Environment variables
.env
.env.local

# Data
# Recursive (**) so per-run subdirectories written by
# `python -m src.data_collection scrape` (data/raw/<source>/<date>/<run>/)
# are excluded too, not just data/raw/'s top level -- see
# src/data_collection/README.md.
data/raw/**/*.csv
data/raw/**/*.jsonl
data/raw/**/*.json
data/processed/*.csv
data/interim/**/*.csv
# data/history/ (src/data_collection/history.py's listings_current.parquet +
# listing_events.jsonl, written by `scrape --track-history`) -- the parquet
# file is already covered by the generic *.parquet rule below, but the
# events log is JSONL scraped-listing data like data/raw/, so needs its own rule.
data/history/**/*.jsonl
# External data:
#   - data/external/osm/*.osm.pbf   -- raw OSM extracts, ~1.5 GB, NEVER in git;
#     re-downloaded by scripts/prepare_osm_poi.py from Geofabrik.
#   - data/external/osm_poi.csv (+ osm_poi_manifest.json) -- the small (~2 MB)
#     derived POI table the geo model needs at inference time. These ARE
#     tracked so a clean clone can serve the geo model without first
#     downloading and parsing 1.5 GB of PBF (see README "Геоданные").
data/external/*
!data/external/osm_poi.csv
!data/external/osm_poi_manifest.json
*.parquet
*.feather

# Models
# Candidate/experiment artifacts are NOT version-controlled (many, large,
# reproducible by rerunning training scripts against the committed dataset/
# pipeline). Two artifacts are the deliberate exception so a clean clone can
# resolve BOTH the current production model and its one-step rollback target
# (models/current_model.json's previous_current_filename) without depending
# on the original training machine's local files:
#   - xgboost_20260909_112549.pkl  -- current production (XGBoost + OSM geo features)
#   - xgboost_20260827_131014.pkl  -- previous pre-geo model, kept for `promote_model.py --rollback`
models/*.pkl
!models/xgboost_20260909_112549.pkl
!models/xgboost_20260827_131014.pkl
models/*.h5
models/*.joblib
# current_model.json is intentionally tracked (see above) -- it is the
# manifest that names the current production artifact.

# Logs
logs/
*.log

# Local analysis/training reports and intermediate metrics -- regenerated
# by scripts/*.py, not part of the published project. Final results live in
# README.md / MODEL_CARD.md / DATA_CARD.md instead.
reports/

