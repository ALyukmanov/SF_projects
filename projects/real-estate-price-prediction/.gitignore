# CatBoost auto-writes training logs here on every fit() unless
# allow_writing_files=False — see notebooks/01_real_estate_price_prediction.ipynb
catboost_info/

# Environment variables
.env
.env.local

# Data
# Recursive (**) so per-run subdirectories written by
# `python -m src.data_collection scrape` (data/raw/<source>/<date>/<run>/)
# are excluded too, not just data/raw/'s top level -- see
# src/data_collection/README.md.
data/raw/**/*.csv
data/raw/**/*.jsonl
data/raw/**/*.json
data/processed/*.csv
data/interim/**/*.csv
# data/history/ (src/data_collection/history.py's listings_current.parquet +
# listing_events.jsonl, written by `scrape --track-history`) -- the parquet
# file is already covered by the generic *.parquet rule below, but the
# events log is JSONL scraped-listing data like data/raw/, so needs its own rule.
data/history/**/*.jsonl
*.parquet
*.feather

# Models
# Candidate/experiment artifacts are NOT version-controlled (many, large,
# reproducible by rerunning training scripts against the committed dataset/
# pipeline). The single artifact actually pointed at by production
# (models/current_model.json, itself tracked below) is the one deliberate
# exception: a clean clone must be able to resolve the production model
# without depending on the original training machine's local files.
models/*.pkl
!models/xgboost_20260827_131014.pkl
models/*.h5
models/*.joblib
# current_model.json is intentionally tracked (see above) -- it is the
# manifest that names the current production artifact.

# Logs
logs/
*.log

# Local analysis/training reports and intermediate metrics -- regenerated
# by scripts/*.py, not part of the published project. Final results live in
# README.md / MODEL_CARD.md / DATA_CARD.md instead.
reports/

