# ─── Windows encoding fix ────────────────────────────────────────────────────
# On Windows (cp1251 terminal), logger may fail on unicode chars (², →, ×).
# Set this to force UTF-8 stdout across all Python scripts.
PYTHONUTF8=1

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
# Required only if you run telegram_bot/bot.py
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Model paths (optional overrides, defaults scan models/ directory) ────────
# MODEL_PATH=models/xgboost_20260103_182820.pkl

# ─── API settings (optional) ─────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000
