{
  "id": null,
  "uid": "ml-model-monitoring",
  "title": "Мониторинг ML-модели",
  "description": "Классификатор качества вина: качество модели, трафик предсказаний, латентность и переобучение.",
  "tags": ["ml", "wine-quality", "prometheus"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Accuracy модели",
      "description": "Accuracy текущей модели на отложенной тестовой выборке.",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "ml_model_accuracy", "refId": "A", "legendFormat": "accuracy" } ],
      "fieldConfig": { "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.6 }, { "color": "green", "value": 0.8 } ] } },
        "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" } },

    { "id": 2, "type": "stat", "title": "F1-score модели",
      "description": "F1-score (среднее гармоническое precision и recall) текущей модели.",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "ml_model_f1_score", "refId": "A", "legendFormat": "f1" } ],
      "fieldConfig": { "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.6 }, { "color": "green", "value": 0.8 } ] } },
        "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" } },

    { "id": 3, "type": "stat", "title": "Precision модели",
      "description": "Precision текущей модели на тестовой выборке.",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "ml_model_precision", "refId": "A", "legendFormat": "precision" } ],
      "fieldConfig": { "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.6 }, { "color": "green", "value": 0.8 } ] } },
        "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" } },

    { "id": 4, "type": "stat", "title": "Recall модели",
      "description": "Recall текущей модели на тестовой выборке.",
      "gridPos": { "x": 15, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "ml_model_recall", "refId": "A", "legendFormat": "recall" } ],
      "fieldConfig": { "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.6 }, { "color": "green", "value": 0.8 } ] } },
        "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" } },

    { "id": 5, "type": "gauge", "title": "ROC AUC",
      "description": "Площадь под ROC-кривой текущей модели.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "ml_model_roc_auc", "refId": "A", "legendFormat": "roc_auc" } ],
      "fieldConfig": { "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.6 }, { "color": "green", "value": 0.8 } ] } },
        "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true } },

    { "id": 6, "type": "stat", "title": "Всего предсказаний",
      "description": "Общее число предсказаний с момента запуска API.",
      "gridPos": { "x": 0, "y": 4, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(ml_predictions_total)", "refId": "A", "legendFormat": "предсказания" } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" } },

    { "id": 7, "type": "timeseries", "title": "Скорость предсказаний",
      "description": "Предсказаний в секунду (rate за 1 минуту).",
      "gridPos": { "x": 4, "y": 4, "w": 7, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(rate(ml_predictions_total[1m]))", "refId": "A", "legendFormat": "предсказаний/с" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 8, "type": "timeseries", "title": "Время ответа модели (p50 / p95 / p99)",
      "description": "Квантили латентности предсказания по метрике ml_prediction_duration_seconds.",
      "gridPos": { "x": 11, "y": 4, "w": 7, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ml_prediction_duration_seconds_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(ml_prediction_duration_seconds_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(ml_prediction_duration_seconds_bucket[5m])) by (le))", "refId": "C", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 9, "type": "timeseries", "title": "Ошибки предсказаний",
      "description": "Частота неудачных запросов на предсказание.",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(rate(ml_prediction_errors_total[5m]))", "refId": "A", "legendFormat": "ошибок/с" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.1 } ] } },
        "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 10, "type": "piechart", "title": "Распределение предсказанных классов",
      "description": "Доля предсказаний по классам (0 = low_quality, 1 = good_quality).",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (predicted_class) (ml_prediction_class_total)", "refId": "A", "legendFormat": "класс {{predicted_class}}", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] } } },

    { "id": 11, "type": "stat", "title": "Количество переобучений",
      "description": "Всего попыток переобучения через /retrain.",
      "gridPos": { "x": 0, "y": 20, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(ml_retraining_total)", "refId": "A", "legendFormat": "попыток" },
        { "expr": "sum(ml_retraining_failures_total)", "refId": "B", "legendFormat": "неудач" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" } },

    { "id": 12, "type": "stat", "title": "Длительность обучения",
      "description": "Средняя длительность обучения (ml_training_duration_seconds).",
      "gridPos": { "x": 4, "y": 20, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "ml_training_duration_seconds_sum / ml_training_duration_seconds_count", "refId": "A", "legendFormat": "ср. длительность" } ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" } },

    { "id": 13, "type": "stat", "title": "Статус сервиса",
      "description": "Доступность API и наличие загруженной модели (1 = работает, 0 = нет).",
      "gridPos": { "x": 8, "y": 20, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "up{job=\"ml-model-api\"}", "refId": "A", "legendFormat": "API" },
        { "expr": "ml_model_loaded", "refId": "B", "legendFormat": "модель загружена" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0,
          "mappings": [ { "type": "value", "options": { "0": { "text": "НЕДОСТУПЕН", "color": "red" }, "1": { "text": "РАБОТАЕТ", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } },
        "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" } },

    { "id": 14, "type": "table", "title": "Информация о модели",
      "description": "Метаданные текущей модели: имя, версия, алгоритм.",
      "gridPos": { "x": 12, "y": 20, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "ml_model_info", "refId": "A", "format": "table", "instant": true } ],
      "transformations": [
        { "id": "organize", "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "instance": true, "job": true },
            "renameByName": { "model_name": "Модель", "model_version": "Версия", "model_type": "Тип" } } } ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true } },

    { "id": 15, "type": "stat", "title": "Train/test и последнее обучение", "description": "Размер train/test выборки последнего обучения и когда оно было.",
      "gridPos": { "x": 18, "y": 20, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "ml_model_training_rows", "refId": "A", "legendFormat": "строк train" },
        { "expr": "ml_model_test_rows", "refId": "B", "legendFormat": "строк test" },
        { "expr": "ml_model_last_training_timestamp_seconds * 1000", "refId": "C", "legendFormat": "последнее обучение" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 },
        "overrides": [ { "matcher": { "id": "byFrameRefID", "options": "C" }, "properties": [ { "id": "unit", "value": "dateTimeAsIso" } ] } ] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" } }
  ]
}
